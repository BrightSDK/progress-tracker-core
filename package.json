    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "c8": "^10.1.0",
    "chai": "^4.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-promise": "^7.2.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "mocha": "^10.8.0",
    "prettier": "^3.4.0",
    "proxyquire": "^2.1.3",
    "sinon": "^15.0.1"
